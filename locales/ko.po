msgstr "배터리 전원"

#: src/main.rs:787
msgid "screen locked"
msgstr "화면 잠김"

#: src/main.rs:788
msgid "the system refused"
msgstr "시스템이 거부함"

#: src/main.rs:796
#, rust-format
msgid "{name}: keeping awake"
msgstr "{name}: 깨어 있음"

#: src/main.rs:798
#, rust-format
