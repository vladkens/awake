msgstr "{name}: 꺼짐"

#: src/window.rs:71
msgid "General"
msgstr "일반"

#: src/window.rs:72
msgid "Battery"
msgstr "배터리"

#: src/window.rs:73
msgid "About"
msgstr "정보"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "Awake를 그리는 UI 툴킷"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "Awake에 영감을 준 앱"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Mac만 깨어 있습니다."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "화면을 잠그면 깨어 있기가 종료됩니다."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "시간 지정 세션 중에 컵 옆에 표시합니다."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "로그인하면 Awake가 열립니다."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "Awake가 열리면 깨어 있기가 켜집니다."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "배터리 사용 시. 이 아래에서 직접 켜면 계속 켜져 있습니다."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "시스템 설정 → 배터리에서 설정합니다."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "깨어 있기는 전원 어댑터에 연결된 동안에만 작동합니다."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr "시스템 설정 → 로그인 항목에서 허용하세요."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Awake.app에서만 작동합니다."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "이 Mac에는 배터리가 없습니다."

#: src/window.rs:146
msgid "Startup"
msgstr "시작"

#: src/window.rs:154
msgid "Launch at login"
msgstr "로그인 시 열기"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "실행 시 깨어 있기"

#: src/window.rs:167
msgid "Screen"
msgstr "화면"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "디스플레이 잠자기 허용"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "화면이 잠기면 끄기"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "메뉴 막대"

#: src/window.rs:176
msgid "Show the time left"
msgstr "남은 시간 표시"

#. Translators: the header of the rows Below 20% battery, In Low Power Mode, When unplugged.
#: src/window.rs:188
msgid "Turn Off Keep Awake"
msgstr "깨어 있기 끄기"

#: src/window.rs:189
#, rust-format
msgid "Below {percent}% battery"
msgstr "배터리 {percent}% 미만"

#. Translators: the battery slider's ticks: 10%, 50%, 90%.
#: src/window.rs:198
#, rust-format
msgid "{percent}%"
msgstr "{percent}%"

#: src/window.rs:201
msgid "Battery level"
msgstr "배터리 잔량"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "저전력 모드일 때"

#: src/window.rs:213
msgid "When unplugged"
msgstr "전원 연결 해제 시"

#: src/window.rs:227
#, rust-format
msgid "Version {version}"
msgstr "버전 {version}"

#: src/window.rs:228
msgid "Keeps your Mac awake from the menu bar."
msgstr "메뉴 막대에서 Mac을 깨어 있게 합니다."

#: src/window.rs:243
msgid "Donate"
msgstr "후원하기"

#: src/window.rs:257
msgid "Acknowledgements"
msgstr "감사의 말"

#: src/window.rs:277
msgid "Check for Updates"
msgstr "업데이트 확인"

#: src/window.rs:280
msgid "Checking for updates…"
msgstr "업데이트 확인 중…"

#: src/window.rs:281
#, rust-format
msgid "{name} is up to date."
msgstr "{name}이(가) 최신 버전입니다."

#: src/window.rs:283
#, rust-format
msgid "{name} {version} is available."
msgstr "{name} {version}을(를) 사용할 수 있습니다."

#: src/window.rs:284
msgid "Install and Relaunch"
msgstr "설치 후 다시 실행"

#: src/window.rs:286
#, rust-format
msgid "Downloading the update… {done}%"
msgstr "업데이트 다운로드 중… {done}%"

#: src/window.rs:289 src/window.rs:296
#, rust-format
msgid "The update failed: {why}"
msgstr "업데이트 실패: {why}"

