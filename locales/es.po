msgid "Battery"
msgstr "Batería"

#: src/window.rs:73
msgid "About"
msgstr "Acerca de"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "El kit de interfaz con el que se dibuja Awake"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "La app que inspiró Awake"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Solo el Mac permanece activo."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Bloquear la pantalla lo desactiva."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "Junto a la taza, mientras dura una sesión con tiempo."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "Awake se abre al iniciar sesión."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "Mantener activo se enciende al abrir Awake."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "Con batería. Si lo activas a mano por debajo, sigue activo."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "Se define en Ajustes del Sistema → Batería."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "Mantener activo solo funciona con el adaptador de corriente."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr "Permítelo en Ajustes del Sistema → Ítems de inicio."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Solo funciona desde Awake.app."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "Este Mac no tiene batería."

#: src/window.rs:146
msgid "Startup"
msgstr "Inicio"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Abrir al iniciar sesión"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Mantener activo al abrir"

#: src/window.rs:167
msgid "Screen"
msgstr "Pantalla"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Permitir el reposo de la pantalla"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Desactivar al bloquear la pantalla"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Barra de menús"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Mostrar el tiempo restante"

