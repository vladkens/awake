#, rust-format
msgid "{percent}%"
msgstr "{percent} %"

#: src/window.rs:201
msgid "Battery level"
msgstr "Nivel de batería"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "En Modo de bajo consumo"

#: src/window.rs:213
msgid "When unplugged"
msgstr "Al desenchufar"

