#, rust-format
msgid "{percent}%"
msgstr "%{percent}"

#: src/window.rs:201
msgid "Battery level"
msgstr "Pil düzeyi"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "Düşük Güç Modu’ndayken"

#: src/window.rs:213
msgid "When unplugged"
