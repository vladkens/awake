msgid "Keeping awake"
msgstr "Uyanık tutuluyor"

#. Translators: {time} is a clock counting down: 59:42, 2:59:42.
#: src/main.rs:634
#, rust-format
msgid "{time} left"
msgstr "{time} kaldı"

#. Translators: the menu's first line after the app turned off by itself, before why.
#: src/main.rs:639
msgid "Turned off"
msgstr "Kapatıldı"

#. Translators: the menu's first line while nothing keeps the Mac awake.
#: src/main.rs:641
msgid "Off"
msgstr "Kapalı"

#. Translators: {names} are the command line's holds, by the names it gave them.
#: src/main.rs:650
#, rust-format
msgid "for {names}"
msgstr "{names} için"

#: src/main.rs:653 src/main.rs:1082
#, rust-format
msgid "not for {names}: {why}"
msgstr "{names} için değil: {why}"

#. Translators: why the Mac can't stay awake, after "Turned off ·" and in "Keeping awake
#. despite {why}"; these and the next ones.
#: src/main.rs:784
msgid "Low Power Mode"
msgstr "Düşük Güç Modu"

#: src/main.rs:785
#, rust-format
msgid "low battery ({percent}%)"
msgstr "pil düşük (%{percent})"

#: src/main.rs:786
msgid "battery power"
msgstr "pil gücü"

#: src/main.rs:787
msgid "screen locked"
msgstr "ekran kilitli"

#: src/main.rs:788
msgid "the system refused"
msgstr "sistem reddetti"

#: src/main.rs:796
#, rust-format
msgid "{name}: keeping awake"
msgstr "{name}: uyanık tutuluyor"

#: src/main.rs:798
#, rust-format
msgid "{name}: off"
msgstr "{name}: kapalı"

#: src/window.rs:71
msgid "General"
msgstr "Genel"

#: src/window.rs:72
msgid "Battery"
msgstr "Pil"

#: src/window.rs:73
msgid "About"
msgstr "Hakkında"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "Awake’in çizildiği arayüz araç takımı"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "Awake’e ilham veren uygulama"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Yalnızca Mac uyanık kalır."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Ekranı kilitlemek uyanık tutmayı bitirir."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "Süreli bir oturum sürerken fincanın yanında."

