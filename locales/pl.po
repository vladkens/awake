#: src/main.rs:164
msgid "Keep Awake For"
msgstr "Nie usypiaj przez"

#: src/main.rs:168
msgid "Settings…"
msgstr "Ustawienia…"

#: src/main.rs:169
#, rust-format
msgid "Quit {name}"
msgstr "Zakończ {name}"

#: src/main.rs:179
#, rust-format
msgid "Update to {version}"
msgstr "Uaktualnij do {version}"

#: src/main.rs:183
#, rust-format
msgid "Downloading {version}… {done}%"
msgstr "Pobieranie {version}… {done}%"

#: src/main.rs:187
#, rust-format
msgid "Retry Update to {version}"
msgstr "Ponów uaktualnienie do {version}"

#: src/main.rs:203
msgid "Keep Awake Indefinitely"
msgstr "Nie usypiaj bez limitu"

#: src/main.rs:203
msgid "Turn Off"
msgstr "Wyłącz"

#: src/main.rs:209
#, rust-format
msgid "{n} Minute"
msgid_plural "{n} Minutes"
msgstr[0] "{n} minuta"
msgstr[1] "{n} minuty"
msgstr[2] "{n} minut"

