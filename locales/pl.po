#, rust-format
msgid "{n} Hour"
msgid_plural "{n} Hours"
msgstr[0] "{n} godzina"
msgstr[1] "{n} godziny"
msgstr[2] "{n} godzin"

#: src/main.rs:628
#, rust-format
msgid "Keeping awake despite {why}"
msgstr "Nie usypia mimo: {why}"

#: src/main.rs:629 src/main.rs:637
msgid "Keeping awake"
msgstr "Nie usypia"

#. Translators: {time} is a clock counting down: 59:42, 2:59:42.
#: src/main.rs:634
#, rust-format
msgid "{time} left"
msgstr "zostało {time}"

#. Translators: the menu's first line after the app turned off by itself, before why.
#: src/main.rs:639
msgid "Turned off"
msgstr "Wyłączono"

#. Translators: the menu's first line while nothing keeps the Mac awake.
#: src/main.rs:641
msgid "Off"
msgstr "Wyłączone"

#. Translators: {names} are the command line's holds, by the names it gave them.
#: src/main.rs:650
#, rust-format
msgid "for {names}"
msgstr "dla {names}"

#: src/main.rs:653 src/main.rs:1082
#, rust-format
msgid "not for {names}: {why}"
msgstr "nie dla {names}: {why}"

#. Translators: why the Mac can't stay awake, after "Turned off ·" and in "Keeping awake
#. despite {why}"; these and the next ones.
#: src/main.rs:784
msgid "Low Power Mode"
msgstr "Tryb niskiego zużycia energii"

#: src/main.rs:785
#, rust-format
msgid "low battery ({percent}%)"
msgstr "niski poziom baterii ({percent}%)"

#: src/main.rs:786
msgid "battery power"
msgstr "zasilanie z baterii"

#: src/main.rs:787
msgid "screen locked"
msgstr "ekran zablokowany"

#: src/main.rs:788
msgid "the system refused"
msgstr "system odmówił"

#: src/main.rs:796
#, rust-format
msgid "{name}: keeping awake"
msgstr "{name}: nie usypia"

#: src/main.rs:798
#, rust-format
msgid "{name}: off"
msgstr "{name}: wyłączone"

#: src/window.rs:71
msgid "General"
msgstr "Ogólne"

#: src/window.rs:72
msgid "Battery"
msgstr "Bateria"

#: src/window.rs:73
msgid "About"
msgstr "O programie"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "Zestaw narzędzi UI, którym rysowany jest Awake"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "Aplikacja, która zainspirowała Awake"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Tylko Mac pozostaje wybudzony."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Zablokowanie ekranu wyłącza tę funkcję."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "Obok filiżanki, podczas sesji na czas."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "Awake otwiera się po zalogowaniu."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "Funkcja włącza się od razu po otwarciu Awake."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "Na baterii. Włączona ręcznie poniżej progu pozostaje włączona."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "Ustawiane w Ustawieniach systemowych → Bateria."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "Funkcja działa tylko przy podłączonym zasilaczu."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr ""
"Zezwól w Ustawieniach systemowych → Rzeczy otwierane podczas logowania."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Działa tylko z Awake.app."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "Ten Mac nie ma baterii."

#: src/window.rs:146
msgid "Startup"
msgstr "Uruchamianie"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Otwieraj po zalogowaniu"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Nie usypiaj po uruchomieniu"

#: src/window.rs:167
msgid "Screen"
msgstr "Ekran"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Pozwól na uśpienie monitora"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Wyłącz po zablokowaniu ekranu"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Pasek menu"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Pokazuj pozostały czas"

#. Translators: the header of the rows Below 20% battery, In Low Power Mode, When unplugged.
#: src/window.rs:188
msgid "Turn Off Keep Awake"
msgstr "Wyłączaj automatycznie"

#: src/window.rs:189
#, rust-format
msgid "Below {percent}% battery"
msgstr "Poniżej {percent}% baterii"

#. Translators: the battery slider's ticks: 10%, 50%, 90%.
#: src/window.rs:198
#, rust-format
msgid "{percent}%"
msgstr "{percent}%"

#: src/window.rs:201
msgid "Battery level"
msgstr "Poziom baterii"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "W trybie niskiego zużycia energii"

#: src/window.rs:213
msgid "When unplugged"
msgstr "Po odłączeniu zasilania"

#: src/window.rs:227
#, rust-format
msgid "Version {version}"
msgstr "Wersja {version}"

#: src/window.rs:228
msgid "Keeps your Mac awake from the menu bar."
msgstr "Nie pozwala Macowi zasnąć – prosto z paska menu."

#: src/window.rs:243
msgid "Donate"
msgstr "Wesprzyj"

#: src/window.rs:257
msgid "Acknowledgements"
msgstr "Podziękowania"

#: src/window.rs:277
msgid "Check for Updates"
msgstr "Sprawdź uaktualnienia"

#: src/window.rs:280
msgid "Checking for updates…"
msgstr "Sprawdzanie uaktualnień…"

#: src/window.rs:281
#, rust-format
msgid "{name} is up to date."
msgstr "{name} jest aktualny."

#: src/window.rs:283
#, rust-format
msgid "{name} {version} is available."
msgstr "{name} {version} jest dostępny."

#: src/window.rs:284
msgid "Install and Relaunch"
msgstr "Zainstaluj i uruchom ponownie"

#: src/window.rs:286
#, rust-format
msgid "Downloading the update… {done}%"
msgstr "Pobieranie uaktualnienia… {done}%"

#: src/window.rs:289 src/window.rs:296
#, rust-format
msgid "The update failed: {why}"
msgstr "Uaktualnienie nie powiodło się: {why}"

#: src/window.rs:290
#, rust-format
msgid "Couldn't check for updates: {why}"
msgstr "Nie można sprawdzić uaktualnień: {why}"

#: src/window.rs:293
msgid "Try Again"
msgstr "Spróbuj ponownie"
