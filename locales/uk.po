#: src/window.rs:71
msgid "General"
msgstr "Загальні"

#: src/window.rs:72
msgid "Battery"
msgstr "Акумулятор"

#: src/window.rs:73
msgid "About"
msgstr "Про програму"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "UI-тулкіт, яким намальовано Awake"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "Програма, що надихнула Awake"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Не засинає лише Mac."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Блокування екрана вимикає Awake."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "Поруч із чашкою, поки триває сеанс на час."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "Awake відкривається під час входу."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "Awake вмикається одразу під час запуску."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "Від акумулятора. Якщо ввімкнути вручну нижче порогу, лишиться ввімкненим."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "Задається в Системних параметрах → Акумулятор."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "Awake працює, лише поки Mac під’єднано до живлення."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr "Дозвольте в Системних параметрах → Об’єкти входу."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Працює лише з Awake.app."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "Цей Mac не має акумулятора."

#: src/window.rs:146
msgid "Startup"
msgstr "Запуск"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Відкривати під час входу"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Вмикати під час запуску"

#: src/window.rs:167
msgid "Screen"
msgstr "Екран"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Дозволити сон дисплея"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Вимикати під час блокування екрана"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Смуга меню"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Показувати залишок часу"

#. Translators: the header of the rows Below 20% battery, In Low Power Mode, When unplugged.
#: src/window.rs:188
msgid "Turn Off Keep Awake"
msgstr "Вимикати автоматично"

#: src/window.rs:189
#, rust-format
msgid "Below {percent}% battery"
msgstr "Заряд нижче {percent} %"

#. Translators: the battery slider's ticks: 10%, 50%, 90%.
#: src/window.rs:198
#, rust-format
msgid "{percent}%"
msgstr "{percent} %"

#: src/window.rs:201
msgid "Battery level"
msgstr "Рівень заряду"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "У режимі низького енергоспоживання"

#: src/window.rs:213
msgid "When unplugged"
msgstr "Після від’єднання живлення"

#: src/window.rs:227
#, rust-format
msgid "Version {version}"
msgstr "Версія {version}"

#: src/window.rs:228
msgid "Keeps your Mac awake from the menu bar."
msgstr "Не дає Mac заснути — зі смуги меню."

#: src/window.rs:243
msgid "Donate"
msgstr "Підтримати"

#: src/window.rs:257
msgid "Acknowledgements"
msgstr "Подяки"

