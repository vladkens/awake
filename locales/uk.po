#, rust-format
msgid "{name} is up to date."
msgstr "Встановлено найновішу версію {name}."

#: src/window.rs:283
#, rust-format
msgid "{name} {version} is available."
msgstr "Доступний {name} {version}."

#: src/window.rs:284
msgid "Install and Relaunch"
msgstr "Інсталювати й перезапустити"

#: src/window.rs:286
#, rust-format
msgid "Downloading the update… {done}%"
msgstr "Завантаження оновлення… {done} %"

