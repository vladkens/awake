#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Разрешить сон дисплея"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Выключать при блокировке экрана"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Строка меню"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Показывать оставшееся время"

