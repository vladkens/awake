#, rust-format
msgid "{time} left"
msgstr "noch {time}"

#. Translators: the menu's first line after the app turned off by itself, before why.
#: src/main.rs:731
msgid "Turned off"
msgstr "Ausgeschaltet"

#. Translators: the menu's first line while nothing keeps the Mac awake.
#: src/main.rs:733
msgid "Off"
