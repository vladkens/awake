#, rust-format
msgid "Version {version}"
msgstr "Version {version}"

#: src/window.rs:228
msgid "Keeps your Mac awake from the menu bar."
msgstr "Hält deinen Mac über die Menüleiste wach."

#: src/window.rs:243
msgid "Donate"
msgstr "Spenden"

#: src/window.rs:257
msgid "Acknowledgements"
msgstr "Danksagungen"

