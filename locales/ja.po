msgstr "起動時にスリープ防止をオン"

#: src/window.rs:165
msgid "Screen"
msgstr "画面"

#: src/window.rs:166
msgid "Let the display sleep"
msgstr "ディスプレイのスリープを許可"

#: src/window.rs:169
msgid "Turn off when the screen locks"
msgstr "画面ロック時にオフにする"

#: src/window.rs:173
