#: src/main.rs:164
msgid "Keep Awake For"
msgstr "スリープさせない時間"

#: src/main.rs:168
msgid "Settings…"
msgstr "設定…"

#: src/main.rs:169
#, rust-format
msgid "Quit {name}"
msgstr "{name}を終了"

#: src/main.rs:179
#, rust-format
msgid "Update to {version}"
msgstr "{version}にアップデート"

#: src/main.rs:183
#, rust-format
msgid "Downloading {version}… {done}%"
msgstr "{version}をダウンロード中… {done}%"

#: src/main.rs:187
#, rust-format
msgid "Retry Update to {version}"
msgstr "{version}へのアップデートを再試行"

#: src/main.rs:203
msgid "Keep Awake Indefinitely"
msgstr "無期限にスリープさせない"

#: src/main.rs:203
msgid "Turn Off"
msgstr "オフにする"

#: src/main.rs:209
#, rust-format
msgid "{n} Minute"
msgid_plural "{n} Minutes"
msgstr[0] "{n}分"

