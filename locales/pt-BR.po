msgid "Startup"
msgstr "Inicialização"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Abrir ao iniciar sessão"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Manter ativo ao abrir"

