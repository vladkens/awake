msgid "Settings…"
msgstr "Impostazioni…"

#: src/main.rs:169
#, rust-format
msgid "Quit {name}"
msgstr "Esci da {name}"

#: src/main.rs:179
#, rust-format
msgid "Update to {version}"
msgstr "Aggiorna a {version}"

