#, rust-format
msgid "{name} is up to date."
msgstr "{name} è aggiornato."

#: src/window.rs:283
#, rust-format
msgid "{name} {version} is available."
msgstr "{name} {version} è disponibile."

#: src/window.rs:284
msgid "Install and Relaunch"
msgstr "Installa e riavvia"

#: src/window.rs:286
#, rust-format
msgid "Downloading the update… {done}%"
msgstr "Download dell’aggiornamento… {done}%"

