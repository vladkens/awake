msgstr "Riprova l’aggiornamento a {version}"

#: src/main.rs:203
msgid "Keep Awake Indefinitely"
msgstr "Mantieni attivo senza limiti"

#: src/main.rs:203
msgid "Turn Off"
msgstr "Disattiva"

#: src/main.rs:209
#, rust-format
msgid "{n} Minute"
msgid_plural "{n} Minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minuti"

