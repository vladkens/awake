#: src/main.rs:628
#, rust-format
msgid "Keeping awake despite {why}"
msgstr "Attivo nonostante: {why}"

#: src/main.rs:629 src/main.rs:637
msgid "Keeping awake"
msgstr "Attivo"

#. Translators: {time} is a clock counting down: 59:42, 2:59:42.
#: src/main.rs:634
#, rust-format
msgid "{time} left"
msgstr "ancora {time}"

#. Translators: the menu's first line after the app turned off by itself, before why.
#: src/main.rs:639
msgid "Turned off"
msgstr "Disattivato"

#. Translators: the menu's first line while nothing keeps the Mac awake.
#: src/main.rs:641
msgid "Off"
msgstr "Disattivato"

#. Translators: {names} are the command line's holds, by the names it gave them.
#: src/main.rs:650
#, rust-format
msgid "for {names}"
msgstr "per {names}"

#: src/main.rs:653 src/main.rs:1082
#, rust-format
msgid "not for {names}: {why}"
msgstr "non per {names}: {why}"

#. Translators: why the Mac can't stay awake, after "Turned off ·" and in "Keeping awake
#. despite {why}"; these and the next ones.
#: src/main.rs:784
msgid "Low Power Mode"
msgstr "Modalità risparmio energetico"

#: src/main.rs:785
#, rust-format
msgid "low battery ({percent}%)"
msgstr "batteria scarica ({percent}%)"

#: src/main.rs:786
msgid "battery power"
msgstr "alimentazione a batteria"

#: src/main.rs:787
msgid "screen locked"
msgstr "schermo bloccato"

#: src/main.rs:788
msgid "the system refused"
msgstr "rifiutato dal sistema"

#: src/main.rs:796
#, rust-format
msgid "{name}: keeping awake"
msgstr "{name}: attivo"

#: src/main.rs:798
#, rust-format
msgid "{name}: off"
msgstr "{name}: disattivato"

#: src/window.rs:71
msgid "General"
msgstr "Generali"

#: src/window.rs:72
msgid "Battery"
msgstr "Batteria"

#: src/window.rs:73
msgid "About"
msgstr "Info"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "Il toolkit di interfaccia con cui è disegnato Awake"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "L’app che ha ispirato Awake"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Resta attivo solo il Mac."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Il blocco dello schermo lo disattiva."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "Accanto alla tazza, durante una sessione a tempo."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "Awake si apre al login."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "Mantieni attivo si accende all’apertura di Awake."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "A batteria. Se attivato a mano sotto la soglia, resta attivo."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "Si imposta in Impostazioni di Sistema → Batteria."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "Mantieni attivo funziona solo con l’alimentatore collegato."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr "Consentilo in Impostazioni di Sistema → Elementi login."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Funziona solo da Awake.app."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "Questo Mac non ha una batteria."

#: src/window.rs:146
msgid "Startup"
msgstr "Avvio"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Apri al login"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Mantieni attivo all’avvio"

#: src/window.rs:167
msgid "Screen"
msgstr "Schermo"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Consenti lo stop del monitor"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Disattiva al blocco dello schermo"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Barra dei menu"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Mostra il tempo rimanente"

#. Translators: the header of the rows Below 20% battery, In Low Power Mode, When unplugged.
#: src/window.rs:188
msgid "Turn Off Keep Awake"
msgstr "Disattiva automaticamente"

#: src/window.rs:189
#, rust-format
msgid "Below {percent}% battery"
msgstr "Batteria sotto il {percent}%"

#. Translators: the battery slider's ticks: 10%, 50%, 90%.
#: src/window.rs:198
#, rust-format
msgid "{percent}%"
msgstr "{percent}%"

#: src/window.rs:201
msgid "Battery level"
msgstr "Livello batteria"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "In modalità risparmio energetico"

#: src/window.rs:213
msgid "When unplugged"
msgstr "Quando è scollegato"

#: src/window.rs:227
#, rust-format
msgid "Version {version}"
msgstr "Versione {version}"

#: src/window.rs:228
msgid "Keeps your Mac awake from the menu bar."
msgstr "Mantiene attivo il Mac dalla barra dei menu."

#: src/window.rs:243
msgid "Donate"
msgstr "Dona"

#: src/window.rs:257
msgid "Acknowledgements"
msgstr "Ringraziamenti"

#: src/window.rs:277
msgid "Check for Updates"
msgstr "Controlla aggiornamenti"

#: src/window.rs:280
msgid "Checking for updates…"
msgstr "Ricerca aggiornamenti…"

