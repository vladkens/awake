#. despite {why}"; these and the next ones.
#: src/main.rs:784
msgid "Low Power Mode"
msgstr "Mode économie d’énergie"

#: src/main.rs:785
#, rust-format
msgid "low battery ({percent}%)"
msgstr "batterie faible ({percent} %)"

#: src/main.rs:786
msgid "battery power"
msgstr "sur batterie"

#: src/main.rs:787
msgid "screen locked"
msgstr "écran verrouillé"

#: src/main.rs:788
msgid "the system refused"
msgstr "refusé par le système"

