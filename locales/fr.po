#: src/window.rs:71
msgid "General"
msgstr "Général"

#: src/window.rs:72
msgid "Battery"
msgstr "Batterie"

#: src/window.rs:73
msgid "About"
msgstr "À propos"

#: src/window.rs:82
msgid "The UI toolkit Awake is drawn with"
msgstr "La boîte à outils d’interface qui dessine Awake"

#: src/window.rs:85
msgid "The app that inspired Awake"
msgstr "L’app qui a inspiré Awake"

#: src/window.rs:90
msgid "Only the Mac stays awake."
msgstr "Seul le Mac reste éveillé."

#: src/window.rs:91
msgid "Locking the screen ends Keep Awake."
msgstr "Verrouiller l’écran met fin à l’éveil."

#: src/window.rs:92
msgid "Beside the cup, while a timed session runs."
msgstr "À côté de la tasse, pendant une session minutée."

#: src/window.rs:93
msgid "Awake opens when you log in."
msgstr "Awake s’ouvre à la connexion."

#: src/window.rs:94
msgid "Keep Awake turns on as Awake opens."
msgstr "L’éveil s’active à l’ouverture d’Awake."

#: src/window.rs:95
msgid "On battery. Turned on by hand below it, it stays on."
msgstr "Sur batterie. Activé à la main en dessous, il reste actif."

#: src/window.rs:96
msgid "Set in System Settings → Battery."
msgstr "Se règle dans Réglages Système → Batterie."

#: src/window.rs:97
msgid "Keep Awake runs only on the power adapter."
msgstr "L’éveil ne fonctionne que sur l’adaptateur secteur."

#: src/window.rs:98
msgid "Allow it in System Settings → Login Items."
msgstr "Autorisez-le dans Réglages Système → Ouverture."

#: src/window.rs:99
msgid "Works only from Awake.app."
msgstr "Ne fonctionne que depuis Awake.app."

#: src/window.rs:100
msgid "This Mac has no battery."
msgstr "Ce Mac n’a pas de batterie."

#: src/window.rs:146
msgid "Startup"
msgstr "Démarrage"

#: src/window.rs:154
msgid "Launch at login"
msgstr "Ouvrir à la connexion"

#: src/window.rs:162
msgid "Keep awake at launch"
msgstr "Garder éveillé à l’ouverture"

#: src/window.rs:167
msgid "Screen"
msgstr "Écran"

#: src/window.rs:168
msgid "Let the display sleep"
msgstr "Laisser l’écran se mettre en veille"

#: src/window.rs:171
msgid "Turn off when the screen locks"
msgstr "Désactiver au verrouillage de l’écran"

#: src/window.rs:175
msgid "Menu Bar"
msgstr "Barre des menus"

#: src/window.rs:176
msgid "Show the time left"
msgstr "Afficher le temps restant"

#. Translators: the header of the rows Below 20% battery, In Low Power Mode, When unplugged.
#: src/window.rs:188
msgid "Turn Off Keep Awake"
msgstr "Désactiver l’éveil"

#: src/window.rs:189
#, rust-format
msgid "Below {percent}% battery"
msgstr "Batterie sous {percent} %"

#. Translators: the battery slider's ticks: 10%, 50%, 90%.
#: src/window.rs:198
#, rust-format
msgid "{percent}%"
msgstr "{percent} %"

#: src/window.rs:201
msgid "Battery level"
msgstr "Niveau de batterie"

#: src/window.rs:209
msgid "In Low Power Mode"
msgstr "En mode économie d’énergie"

#: src/window.rs:213
msgid "When unplugged"
msgstr "Une fois débranché"

